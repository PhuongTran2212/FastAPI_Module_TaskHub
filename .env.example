DATABASE_URL=postgresql+asyncpg://taskhub:CHANGE_ME@localhost:5432/taskhub

# Generate a private key: openssl rand -hex 32
# Python alternative: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0
TASK_CACHE_ENABLED=true
TASK_CACHE_TTL_SECONDS=60
REDIS_TIMEOUT_SECONDS=0.2

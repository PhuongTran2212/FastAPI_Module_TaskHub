DATABASE_URL=postgresql+asyncpg://taskhub:CHANGE_ME@localhost:5432/taskhub

# Generate a private key: openssl rand -hex 32
# Python alternative: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0
TASK_CACHE_ENABLED=true
TASK_CACHE_TTL_SECONDS=60
REDIS_TIMEOUT_SECONDS=0.2

# Day 7: cache uses Redis DB 0; Celery uses DB 1 (no result backend).
CELERY_BROKER_URL=redis://localhost:6379/1
JOB_CONNECTION_TIMEOUT_SECONDS=2
JOB_MAX_RETRIES=3
ASSIGNMENT_EMAIL_ENABLED=false
ASSIGNMENT_EMAIL_EXPIRES_SECONDS=3600
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=taskhub@example.com
SMTP_SECURITY=none
# Configure BOTH only for an authenticated SMTP server using starttls or ssl:
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=5
REFRESH_CLEANUP_INTERVAL_SECONDS=300
REFRESH_CLEANUP_BATCH_SIZE=500

# Compose uses an isolated DB volume and overrides service hostnames above.
# Use a URL-safe password. Changing this does not reset an existing DB volume.
POSTGRES_PASSWORD=taskhub_dev
REDIS_MAX_CONNECTIONS=10
REDIS_POOL_WAIT_SECONDS=0.1

REFRESH_CLEANUP_BUDGET_SECONDS=30
